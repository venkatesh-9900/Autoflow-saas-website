# Example .env file for Omnichannel Automation Platform

# --- Backend ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=your_jwt_secret
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
STRIPE_SECRET_KEY=your_stripe_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
WHATSAPP_API_KEY=your_whatsapp_api_key
EMAIL_SMTP_HOST=your_smtp_host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_smtp_user
EMAIL_SMTP_PASS=your_smtp_password
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
NODE_ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_KEY=your_stripe_publishable_key
NEXT_PUBLIC_RAZORPAY_KEY=your_razorpay_key_id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_WHATSAPP_WIDGET_KEY=your_whatsapp_widget_key
NEXT_PUBLIC_ENV=development
